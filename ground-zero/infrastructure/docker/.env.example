# Ground-Zero Infrastructure - Environment Configuration
# Copy this file to .env and fill in your values

# PostgreSQL (REQUIRED)
POSTGRES_USER=groundzero
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=groundzero

# Redis (REQUIRED)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# n8n (REQUIRED)
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_N8N_PASSWORD_HERE
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678

# Ollama
OLLAMA_MODEL=llama2

# Agent Zero Configuration
AGENT_POLL_INTERVAL=5
AGENT_MAX_RETRIES=3
LOG_LEVEL=INFO

# Timezone
TZ=UTC

# Monitoring (Optional - for Grafana)
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD_HERE

# Security Notes:
# 1. Generate strong passwords (min 32 characters)
# 2. Never commit .env to version control
# 3. Use different passwords for each service
# 4. Rotate passwords regularly (every 90 days)
#
# Password Generation Command:
#   openssl rand -base64 32

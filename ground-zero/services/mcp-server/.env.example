# Ground-Zero MCP Server Configuration
# Copy to .env and configure for your environment

# DigitalOcean Droplet Configuration
# Replace with your droplet's Headscale VPN IP
DIGITALOCEAN_HOST=http://100.64.0.1

# n8n Webhook Base URL
N8N_WEBHOOK_BASE=http://100.64.0.1:5678/webhook

# PostgreSQL API Base (for direct queries - optional)
POSTGRES_API_BASE=http://100.64.0.1:5432

# Logging
LOG_LEVEL=info

# Notes:
# - 100.64.0.1 is example Headscale VPN IP, replace with actual
# - All traffic goes through VPN tunnel (encrypted)
# - No authentication needed (VPN provides security layer)

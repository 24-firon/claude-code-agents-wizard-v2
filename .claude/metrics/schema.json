{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claude Code Agents Metrics Schema",
  "description": "Comprehensive schema for tracking orchestration metrics",
  "definitions": {
    "sessionMetrics": {
      "type": "object",
      "description": "Metrics for a single orchestration session",
      "required": [
        "session_id",
        "schema_version",
        "start_timestamp",
        "workspace_name",
        "todos",
        "agents",
        "stuck_invocations",
        "token_usage"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Unique session identifier (format: session-YYYY-MM-DD-NNN)",
          "pattern": "^session-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
          "example": "session-2025-11-18-001"
        },
        "schema_version": {
          "type": "string",
          "description": "Version of this schema",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "example": "1.0.0"
        },
        "start_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when session started",
          "example": "2025-11-18T10:30:00.000Z"
        },
        "end_timestamp": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 timestamp when session ended (null if still running)",
          "example": "2025-11-18T11:45:30.000Z"
        },
        "duration_seconds": {
          "type": ["number", "null"],
          "description": "Total session duration in seconds (null if still running)",
          "minimum": 0,
          "example": 4530
        },
        "workspace_name": {
          "type": "string",
          "description": "Name of the workspace/project being worked on",
          "example": "react-todo-app"
        },
        "user_request_summary": {
          "type": "string",
          "description": "Brief non-sensitive summary of user's request",
          "maxLength": 200,
          "example": "Build a React todo application with state management"
        },
        "todos": {
          "type": "object",
          "description": "Todo list metrics",
          "required": ["created", "completed", "blocked", "in_progress"],
          "properties": {
            "created": {
              "type": "integer",
              "description": "Total number of todos created",
              "minimum": 0
            },
            "completed": {
              "type": "integer",
              "description": "Number of todos successfully completed",
              "minimum": 0
            },
            "blocked": {
              "type": "integer",
              "description": "Number of todos blocked/failed",
              "minimum": 0
            },
            "in_progress": {
              "type": "integer",
              "description": "Number of todos currently in progress",
              "minimum": 0
            },
            "completion_rate": {
              "type": "number",
              "description": "Percentage of todos completed (completed/created * 100)",
              "minimum": 0,
              "maximum": 100
            },
            "average_completion_time_seconds": {
              "type": ["number", "null"],
              "description": "Average time to complete a todo in seconds",
              "minimum": 0
            },
            "completion_times": {
              "type": "array",
              "description": "Individual completion times for each todo",
              "items": {
                "type": "object",
                "properties": {
                  "todo_index": {
                    "type": "integer",
                    "description": "Index of the todo (0-based)"
                  },
                  "duration_seconds": {
                    "type": "number",
                    "description": "Time taken to complete this todo"
                  },
                  "attempts": {
                    "type": "integer",
                    "description": "Number of attempts before completion"
                  }
                }
              }
            }
          }
        },
        "agents": {
          "type": "object",
          "description": "Per-agent metrics",
          "required": ["coder", "tester", "stuck"],
          "properties": {
            "coder": {
              "$ref": "#/definitions/agentMetrics",
              "description": "Metrics for the coder agent"
            },
            "tester": {
              "$ref": "#/definitions/agentMetrics",
              "description": "Metrics for the tester agent"
            },
            "stuck": {
              "$ref": "#/definitions/agentMetrics",
              "description": "Metrics for the stuck agent"
            }
          }
        },
        "stuck_invocations": {
          "type": "array",
          "description": "Detailed log of stuck agent invocations",
          "items": {
            "type": "object",
            "required": ["timestamp", "reason_category", "invoked_by"],
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "When stuck agent was invoked"
              },
              "reason_category": {
                "type": "string",
                "description": "Categorized reason for stuck invocation",
                "enum": [
                  "test_failure",
                  "implementation_error",
                  "dependency_issue",
                  "clarification_needed",
                  "environment_issue",
                  "timeout",
                  "other"
                ]
              },
              "invoked_by": {
                "type": "string",
                "description": "Which agent invoked stuck",
                "enum": ["coder", "tester", "orchestrator"]
              },
              "todo_index": {
                "type": "integer",
                "description": "Which todo was being processed"
              },
              "resolution_action": {
                "type": ["string", "null"],
                "description": "How the issue was resolved",
                "enum": [
                  "user_provided_fix",
                  "user_clarified_requirements",
                  "user_approved_workaround",
                  "user_skipped_task",
                  "user_canceled_session",
                  null
                ]
              },
              "resolution_time_seconds": {
                "type": ["number", "null"],
                "description": "Time from stuck invocation to resolution"
              }
            }
          }
        },
        "token_usage": {
          "type": "object",
          "description": "Estimated token consumption",
          "required": ["total_estimated", "by_agent"],
          "properties": {
            "total_estimated": {
              "type": "integer",
              "description": "Total estimated tokens across all agents",
              "minimum": 0
            },
            "by_agent": {
              "type": "object",
              "description": "Token breakdown by agent type",
              "properties": {
                "orchestrator": {
                  "type": "integer",
                  "minimum": 0
                },
                "coder": {
                  "type": "integer",
                  "minimum": 0
                },
                "tester": {
                  "type": "integer",
                  "minimum": 0
                },
                "stuck": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "context_window_used_percentage": {
              "type": "number",
              "description": "Percentage of orchestrator's 200k context used",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "performance": {
          "type": "object",
          "description": "Performance metrics",
          "properties": {
            "tasks_per_hour": {
              "type": ["number", "null"],
              "description": "Throughput in completed tasks per hour"
            },
            "average_agent_response_time_seconds": {
              "type": "number",
              "description": "Average time for agent to respond"
            },
            "test_pass_rate": {
              "type": "number",
              "description": "Percentage of tests passing on first attempt",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Current session status",
          "enum": ["in_progress", "completed", "failed", "canceled"]
        }
      }
    },
    "agentMetrics": {
      "type": "object",
      "description": "Metrics for a specific agent type",
      "required": ["total_invocations", "successful", "failed"],
      "properties": {
        "total_invocations": {
          "type": "integer",
          "description": "Total number of times this agent was invoked",
          "minimum": 0
        },
        "successful": {
          "type": "integer",
          "description": "Number of successful invocations",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "description": "Number of failed invocations",
          "minimum": 0
        },
        "success_rate": {
          "type": "number",
          "description": "Percentage of successful invocations",
          "minimum": 0,
          "maximum": 100
        },
        "average_duration_seconds": {
          "type": ["number", "null"],
          "description": "Average time for this agent to complete",
          "minimum": 0
        },
        "total_duration_seconds": {
          "type": "number",
          "description": "Total time spent in this agent",
          "minimum": 0
        },
        "invocations": {
          "type": "array",
          "description": "Individual invocation records",
          "items": {
            "type": "object",
            "properties": {
              "start_timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "end_timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "duration_seconds": {
                "type": "number"
              },
              "success": {
                "type": "boolean"
              },
              "todo_index": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "dailyAggregated": {
      "type": "object",
      "description": "Aggregated metrics for a single day",
      "required": [
        "date",
        "schema_version",
        "session_count",
        "sessions",
        "totals",
        "averages",
        "success_rates"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "description": "Date for this aggregation (YYYY-MM-DD)",
          "example": "2025-11-18"
        },
        "schema_version": {
          "type": "string",
          "example": "1.0.0"
        },
        "session_count": {
          "type": "integer",
          "description": "Number of sessions on this day",
          "minimum": 0
        },
        "sessions": {
          "type": "array",
          "description": "List of session IDs included",
          "items": {
            "type": "string"
          }
        },
        "totals": {
          "type": "object",
          "description": "Sum totals across all sessions",
          "properties": {
            "todos_created": {"type": "integer"},
            "todos_completed": {"type": "integer"},
            "todos_blocked": {"type": "integer"},
            "agent_invocations": {
              "type": "object",
              "properties": {
                "coder": {"type": "integer"},
                "tester": {"type": "integer"},
                "stuck": {"type": "integer"}
              }
            },
            "stuck_invocations": {"type": "integer"},
            "total_duration_seconds": {"type": "number"},
            "total_tokens_estimated": {"type": "integer"}
          }
        },
        "averages": {
          "type": "object",
          "description": "Average values across sessions",
          "properties": {
            "todos_per_session": {"type": "number"},
            "completion_rate": {"type": "number"},
            "session_duration_seconds": {"type": "number"},
            "task_completion_time_seconds": {"type": "number"},
            "tokens_per_session": {"type": "number"}
          }
        },
        "success_rates": {
          "type": "object",
          "properties": {
            "overall_completion_rate": {"type": "number"},
            "coder_success_rate": {"type": "number"},
            "tester_success_rate": {"type": "number"},
            "first_time_success_rate": {"type": "number"}
          }
        },
        "top_stuck_reasons": {
          "type": "array",
          "description": "Most common reasons for stuck invocations",
          "items": {
            "type": "object",
            "properties": {
              "reason_category": {"type": "string"},
              "count": {"type": "integer"},
              "percentage": {"type": "number"}
            }
          }
        },
        "most_active_agent": {
          "type": "string",
          "enum": ["coder", "tester", "stuck"]
        }
      }
    },
    "weeklyAggregated": {
      "type": "object",
      "description": "Aggregated metrics for a calendar week",
      "required": [
        "week_id",
        "schema_version",
        "start_date",
        "end_date",
        "session_count",
        "totals",
        "averages",
        "success_rates"
      ],
      "properties": {
        "week_id": {
          "type": "string",
          "description": "ISO week identifier (YYYY-WWW)",
          "pattern": "^\\d{4}-W\\d{2}$",
          "example": "2025-W47"
        },
        "schema_version": {"type": "string"},
        "start_date": {
          "type": "string",
          "format": "date",
          "description": "First day of the week (Monday)"
        },
        "end_date": {
          "type": "string",
          "format": "date",
          "description": "Last day of the week (Sunday)"
        },
        "session_count": {"type": "integer"},
        "daily_breakdown": {
          "type": "array",
          "description": "Per-day metrics within the week",
          "items": {
            "type": "object",
            "properties": {
              "date": {"type": "string", "format": "date"},
              "session_count": {"type": "integer"},
              "todos_completed": {"type": "integer"}
            }
          }
        },
        "totals": {
          "type": "object",
          "description": "Sum totals across the week",
          "properties": {
            "todos_created": {"type": "integer"},
            "todos_completed": {"type": "integer"},
            "total_duration_seconds": {"type": "number"}
          }
        },
        "averages": {
          "type": "object",
          "properties": {
            "sessions_per_day": {"type": "number"},
            "todos_per_day": {"type": "number"},
            "completion_rate": {"type": "number"}
          }
        },
        "success_rates": {
          "$ref": "#/definitions/dailyAggregated/properties/success_rates"
        },
        "trends": {
          "type": "object",
          "description": "Week-over-week trends",
          "properties": {
            "completion_rate_change": {
              "type": "number",
              "description": "Change in completion rate vs previous week"
            },
            "productivity_change": {
              "type": "number",
              "description": "Change in todos/hour vs previous week"
            }
          }
        }
      }
    },
    "allTimeAggregated": {
      "type": "object",
      "description": "Cumulative all-time metrics",
      "required": [
        "schema_version",
        "first_session_date",
        "last_updated",
        "total_sessions",
        "totals",
        "averages",
        "success_rates"
      ],
      "properties": {
        "schema_version": {"type": "string"},
        "first_session_date": {
          "type": "string",
          "format": "date",
          "description": "Date of first recorded session"
        },
        "last_session_date": {
          "type": "string",
          "format": "date",
          "description": "Date of most recent session"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time",
          "description": "When this aggregate was last updated"
        },
        "total_sessions": {
          "type": "integer",
          "description": "Total number of sessions all-time",
          "minimum": 0
        },
        "totals": {
          "type": "object",
          "properties": {
            "todos_created": {"type": "integer"},
            "todos_completed": {"type": "integer"},
            "todos_blocked": {"type": "integer"},
            "coder_invocations": {"type": "integer"},
            "tester_invocations": {"type": "integer"},
            "stuck_invocations": {"type": "integer"},
            "total_duration_hours": {"type": "number"},
            "total_tokens_estimated": {"type": "integer"}
          }
        },
        "averages": {
          "type": "object",
          "properties": {
            "todos_per_session": {"type": "number"},
            "completion_rate": {"type": "number"},
            "session_duration_minutes": {"type": "number"},
            "task_completion_time_minutes": {"type": "number"}
          }
        },
        "success_rates": {
          "type": "object",
          "properties": {
            "overall_completion_rate": {"type": "number"},
            "coder_success_rate": {"type": "number"},
            "tester_success_rate": {"type": "number"},
            "first_time_success_rate": {"type": "number"}
          }
        },
        "all_time_top_stuck_reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reason_category": {"type": "string"},
              "total_count": {"type": "integer"},
              "percentage_of_all_stuck": {"type": "number"}
            }
          }
        },
        "milestones": {
          "type": "object",
          "description": "Notable achievements",
          "properties": {
            "total_todos_completed": {"type": "integer"},
            "longest_session_hours": {"type": "number"},
            "best_completion_rate": {"type": "number"},
            "most_productive_day": {
              "type": "object",
              "properties": {
                "date": {"type": "string", "format": "date"},
                "todos_completed": {"type": "integer"}
              }
            }
          }
        },
        "trends": {
          "type": "object",
          "description": "Historical trends",
          "properties": {
            "monthly_completion_rates": {
              "type": "array",
              "description": "Completion rate per month",
              "items": {
                "type": "object",
                "properties": {
                  "month": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"},
                  "completion_rate": {"type": "number"}
                }
              }
            },
            "improvement_trajectory": {
              "type": "string",
              "enum": ["improving", "stable", "declining"],
              "description": "Overall trend direction"
            }
          }
        }
      }
    }
  }
}

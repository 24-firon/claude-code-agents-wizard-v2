# ==============================================================================
# Node.js Multi-Stage Production Dockerfile
# ==============================================================================
# This Dockerfile uses multi-stage builds for smaller, more secure images
# Supports Node.js 18 and 20 LTS versions
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Dependencies
# ------------------------------------------------------------------------------
FROM node:20-alpine AS dependencies

# Install security updates
RUN apk update && apk upgrade --no-cache

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY yarn.lock* ./
COPY pnpm-lock.yaml* ./

# Install dependencies
# Use the package manager that matches your lock file
RUN if [ -f yarn.lock ]; then yarn install --frozen-lockfile --production; \
    elif [ -f pnpm-lock.yaml ]; then corepack enable && pnpm install --prod --frozen-lockfile; \
    else npm ci --only=production; fi

# ------------------------------------------------------------------------------
# Stage 2: Build
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files and install ALL dependencies (including dev)
COPY package*.json ./
COPY yarn.lock* ./
COPY pnpm-lock.yaml* ./

RUN if [ -f yarn.lock ]; then yarn install --frozen-lockfile; \
    elif [ -f pnpm-lock.yaml ]; then corepack enable && pnpm install --frozen-lockfile; \
    else npm ci; fi

# Copy source code
COPY . .

# Build the application (adjust this command based on your build process)
RUN if [ -f "package.json" ] && grep -q "\"build\"" package.json; then \
      if [ -f yarn.lock ]; then yarn build; \
      elif [ -f pnpm-lock.yaml ]; then pnpm build; \
      else npm run build; fi; \
    fi

# ------------------------------------------------------------------------------
# Stage 3: Production Runtime
# ------------------------------------------------------------------------------
FROM node:20-alpine AS production

# Install dumb-init to handle signals properly
RUN apk add --no-cache dumb-init

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

# Copy production dependencies from dependencies stage
COPY --from=dependencies --chown=nodejs:nodejs /app/node_modules ./node_modules

# Copy built application from builder stage
COPY --from=builder --chown=nodejs:nodejs /app/package*.json ./
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist
# If you have a different build output directory, adjust the path above
# Common alternatives: /app/build, /app/out, /app/.next

# Copy other necessary files
COPY --chown=nodejs:nodejs public ./public 2>/dev/null || true
COPY --chown=nodejs:nodejs .env.example ./.env.example 2>/dev/null || true

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000

# Switch to non-root user
USER nodejs

# Expose the application port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Use dumb-init to handle signals
ENTRYPOINT ["dumb-init", "--"]

# Start the application
CMD ["node", "dist/index.js"]
# Alternative start commands:
# CMD ["node", "dist/server.js"]
# CMD ["node", "dist/main.js"]
# CMD ["npm", "start"]

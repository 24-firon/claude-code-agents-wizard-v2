# Python cache
__pycache__/
*.pyc
*.pyo

# Test messages (keep directory structure, ignore message files)
messages/inbox/**/*.json
messages/processing/**/*.json
messages/completed/**/*.json
messages/failed/**/*.json

# Agent-specific deployment scripts (generated by deploy-agent.sh)
agents/CCW-*-deployment.py

# Keep directory structure
!messages/inbox/.gitkeep
!messages/processing/.gitkeep
!messages/completed/.gitkeep
!messages/failed/.gitkeep

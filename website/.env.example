# Environment Variables Template
# Copy this file to .env.local for local development
# Set these variables in Vercel dashboard for production

# ===================================
# Email Service (Resend)
# ===================================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_123456789

# Email addresses
FROM_EMAIL=hello@kiagentur.com
ADMIN_EMAIL=team@kiagentur.com
REPLY_TO_EMAIL=hello@kiagentur.com

# ===================================
# CMS (Sanity)
# ===================================
# Get these from your Sanity project dashboard
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-api-token

# Webhook secret for Sanity CMS updates
# Generate a secure random string
SANITY_WEBHOOK_SECRET=your-secure-webhook-secret

# ===================================
# Calendar Booking (Calendly)
# ===================================
# Get from Calendly webhook settings
CALENDLY_WEBHOOK_SECRET=your-calendly-webhook-secret

# ===================================
# Analytics (Plausible)
# ===================================
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=kiagentur.com

# ===================================
# Workflow Automation (n8n) - Optional
# ===================================
# n8n webhook URLs for CRM integration
N8N_WEBHOOK_URL=https://n8n.kiagentur.com/webhook/contact
N8N_NEWSLETTER_WEBHOOK_URL=https://n8n.kiagentur.com/webhook/newsletter
N8N_CALENDLY_WEBHOOK_URL=https://n8n.kiagentur.com/webhook/calendly

# ===================================
# Email Marketing Platform - Optional
# ===================================
# ConvertKit (or your chosen platform)
CONVERTKIT_API_KEY=your-api-key
CONVERTKIT_FORM_ID=your-form-id

# ===================================
# CRM - Optional (if direct integration)
# ===================================
# HubSpot
HUBSPOT_API_KEY=your-hubspot-key

# Pipedrive
PIPEDRIVE_API_TOKEN=your-pipedrive-token
PIPEDRIVE_API_URL=https://api.pipedrive.com/v1

# ===================================
# Deployment (Vercel) - Optional
# ===================================
# For triggering rebuilds from webhooks
VERCEL_DEPLOY_HOOK=your-deploy-hook-url

# ===================================
# Security
# ===================================
# Generate secure secrets with: openssl rand -base64 32
PREVIEW_SECRET=your-preview-secret-for-cms

# ===================================
# Development Only
# ===================================
NODE_ENV=development
